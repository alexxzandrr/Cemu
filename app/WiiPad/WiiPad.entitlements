<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Wii U games need more than the default per-app memory limit (~3.4 GB on iPhone Duo). The sideloading
	     account's App ID must have the capability (e.g. enabled with GetMoreRam), or the signer drops it. -->
	<key>com.apple.developer.kernel.increased-memory-limit</key>
	<true/>
	<!-- StikDebug (JIT) must be able to attach -->
	<key>get-task-allow</key>
	<true/>
</dict>
</plist>
